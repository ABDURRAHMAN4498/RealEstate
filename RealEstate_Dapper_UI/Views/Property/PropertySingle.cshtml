@model SinglePropertyVM
@{
    ViewBag.Title = "PropertySingle";
    Layout = "~/Views/Shared/_DefaultLayout.cshtml";
}

@* <section class="w3l-about-breadcrumb"> *@
@* <div class="breadcrumb-bg breadcrumb-bg-about pt-5"> *@
@*     <div class="container pt-lg-5 py-3"> *@
@*     </div> *@
@* </div> *@
@* </section> *@
<section class="w3l-breadcrumb">
    <div class="container">
        <ul class="breadcrumbs-custom-path">
            <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
            <li class="active"><span class="fa fa-angle-right mx-2" aria-hidden="true"></span> İlanlar</li>
            <li class="active"><span class="fa fa-angle-right mx-2" aria-hidden="true"></span> property single</li>
        </ul>
    </div>
</section>
<!--/blog-post-->
<section class="w3l-blog post-content py-5">
    <div class="container py-lg-4 py-md-3 py-2">
        <div class="inner mb-4">
            <ul class="blog-single-author-date align-items-center">
                <li>
                    <div class="listing-category"><span>@Model.Product.type</span></div>
                </li>
                <li><span
                        class="fa fa-clock-o"></span> @((Model.Month > 0 ? $"{Model.Month} ay " : "") + (Model.Day > 0 ? $"{Model.Day} gün " : ""))önce
                </li>
                <li><span class="fa fa-eye"></span> 250 views</li>
            </ul>
        </div>
        <div class="post-content">
            <h2 class="title-single">@Model.Product.title</h2>
        </div>
        <div class="blo-singl mb-4">
            <ul class="blog-single-author-date align-items-center">
                <li>
                    <p>@Model.Product.address, @Model.Product.city, @Model.Product.district </p>
                </li>
                <li><span class="fa fa-bed"></span> @Model.ProductDetail.badRoomCount Yatak Odası</li>
                <li><span class="fa fa-bath"></span> @Model.ProductDetail.bathRoomCount Banyo</li>
                <li><span class="fa fa-share-square-o"></span> @Model.ProductDetail.ProductSize (m²)</li>
            </ul>
            <ul class="share-post">
                <a href="#url" class="cost-estate m-o">@Model.Product.price.ToString("c")</a>
            </ul>
        </div>
        <div class="row">
            <div class="col-lg-8 w3l-news">
                <div class="blog-single-post">
                    <div class="single-post-image mb-5">
                        <div class="owl-blog owl-carousel owl-theme">
                            @foreach (var image in Model.ProductImage)
                            {
                                <div class="item">
                                    <div class="card">
                                        <img src="@image.imageUrl" style="height: 500px;" class="img-fluid radius-image"
                                             alt="@image.productId">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="single-post-content">
                        <h3 class="post-content-title mb-3">İlan Açıklaması</h3>
                        <p class="mb-4">
                            @Model.Product.description </p>
                        <div class="single-bg-white">
                            <h3 class="post-content-title mb-4">İlan Detayları</h3>
                            <ul class="details-list">
                                <li><strong>İlan Id :</strong> @Model.Product.productId</li>
                                <li><strong>(m²) :</strong> @Model.ProductDetail.ProductSize</li>
                                <li><strong>Rooms :</strong> 2</li>
                                <li><strong>Yatak Odası :</strong> @Model.ProductDetail.badRoomCount</li>
                                <li><strong>Banyo :</strong> @Model.ProductDetail.bathRoomCount</li>
                                <li><strong>Exterior material :</strong> Brick</li>
                                <li><strong>Yapı Türü :</strong> Beton</li>
                                <li><strong>Garaj Sayısı :</strong> @Model.ProductDetail.garagSize</li>
                                <li><strong>Garages :</strong> 15</li>
                                <li><strong>Fiyat :</strong> @Model.Product.price.ToString("c")</li>
                                <li><strong>Yapım Yılı :</strong> @Model.ProductDetail.buildYear</li>
                                <li><strong>İlan Tarihi :</strong> @Model.Product.advertisementDate.ToString("dd-MMM-yyyy")</li>
                            </ul>
                        </div>
                        <div class="single-bg-white">
                            <h3 class="post-content-title mb-4">Amenities</h3>
                            <ul class="details-list">
                                <li><strong>Air Conditioning </strong></li>
                                <li><strong>Buil-In Wardrobes </strong></li>
                                <li><strong>Dishwasher</strong></li>
                                <li><strong>Floor Coverings </strong></li>
                                <li><strong>Medical / Clinic </strong></li>
                                <li><strong>Fencing</strong></li>
                                <li><strong>Internet and wifi </strong></li>
                            </ul>
                        </div>
                    </div>

                    <div class="single-bg-white">
                        <h3 class="post-content-title mb-4">Location</h3>
                        <div class="agent-map">
                            <iframe
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d387190.2895687731!2d-74.26055986835598!3d40.697668402590374!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew+York%2C+NY%2C+USA!5e0!3m2!1sen!2sin!4v1562582305883!5m2!1sen!2sin"
                                frameborder="0" style="border:0" allowfullscreen=""></iframe>
                        </div>
                    </div>

                    <div class="single-bg-white mb-0">
                        <h3 class="post-content-title mb-4">Video</h3>
                        <div class="post-content">
                            <iframe src="https://www.youtube.com/embed/jqP3m3ElcxA" frameborder="0"
                                    allowfullscreen=""></iframe>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sidebar-side col-lg-4 col-md-12 col-sm-12 mt-lg-0 mt-5">
                <aside class="sidebar">

                    <!-- Popular Post Widget-->
                    <div class="sidebar-widget popular-posts">
                        <div class="sidebar-title">
                            <h4>Emlakçı İletişim Bilgileri</h4>
                        </div>
                        <article class="post">
                            <figure class="post-thumb"><img src="@Model.AppUser.UserImageUrl" class="radius-image" alt="">
                            </figure>
                            <div class="text mb-0"><a href="#blog-single"> @Model.AppUser.Name</a>
                                <div class="post-info">@Model.AppUser.PhoneNumber</div>
                                <div class="post-info">@Model.AppUser.Email</div>
                            </div>
                        </article>
                        <button type="submit" class="btn btn-primary btn-style w-100">Detaylı İletişim Bilgileri</button>
                    </div>


                    <!-- Popular Post Widget-->
                    <div class="sidebar-widget popular-posts">
                        <div class="sidebar-title">
                            <h4>Emlakçıya Ait Diğer İlanlar</h4>
                        </div>

                        <article class="post">
                            <figure class="post-thumb"><img src="~/starter/assets/images/l1.jpg" class="radius-image"
                                                            alt="">
                            </figure>
                            <div class="text"><a href="#blog-single">Why we are the best in the business
                                </a>
                                <div class="post-info">Sep 09, 2020 - 2 comments</div>
                            </div>
                        </article>

                        <article class="post">
                            <figure class="post-thumb"><img src="~/starter/assets/images/l2.jpg" class="radius-image"
                                                            alt="">
                            </figure>
                            <div class="text"><a href="#blog-single">Build your next landing page.
                                </a>
                                <div class="post-info">Sep 09, 2020 - 2 comments</div>
                            </div>
                        </article>

                        <article class="post">
                            <figure class="post-thumb"><img src="~/starter/assets/images/l3.jpg" class="radius-image"
                                                            alt="">
                            </figure>
                            <div class="text"><a href="#blog-single">
                                    Simply the best. Better than the rest.</a>
                                <div class="post-info">Sep 10, 2020 - 2 comments</div>
                            </div>
                        </article>

                    </div>

                </aside>
            </div>
        </div>
    </div>
</section>
