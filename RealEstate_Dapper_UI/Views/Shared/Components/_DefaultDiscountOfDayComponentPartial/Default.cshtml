@model List<ResultLast3ProductWithCategoryDto>
<div class="w3l-news" id="news">
    <section id="grids5-block" class="py-5">
        <div class="container py-lg-5 py-md-4 py-2">
            <h3 class="title-big text-center">Son Eklenen 3 İlan</h3>
            <div class="row mt-lg-5 mt-4 pt-3">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 mt-md-0 mt-sm-4">

                        <div class="grids5-info">
                            <span class="posted-date">
                                <a href="#">
                                    <span class="small">@item.AdvertisementDate.ToString("yyyy")</span>
                                    <span class="big">@item.AdvertisementDate.ToString("dd")</span>
                                    <span class="small">@item.AdvertisementDate.ToString("MMM")</span>
                                </a>
                            </span>
                            <a asp-controller="Property" asp-action="PropertySingle" asp-route-id="@item.ProductId" class="d-block zoom">
                                <img src="@item.CoverImage" alt="" loading="lazy" style="height: 300px;"
                                     class="img-fluid news-image"/>
                            </a>
                            <div class="blog-info">
                                <a asp-controller="Property" asp-action="PropertySingle" asp-route-id="@item.ProductId" class="category">@item.CategoryName</a>
                                <h4><a asp-controller="Property" asp-action="PropertySingle" asp-route-id="@item.ProductId">@item.Title</a></h4>
                                @if (item.Description.Length >= 100)
                                {
                                    <p>@item.Description.Substring(0, 100)...</p>
                                }
                                else
                                {
                                    <p>@item.Description</p>
                                }

                            </div>
                        </div>

                    </div>
                }
            </div>
        </div>
    </section>
</div>